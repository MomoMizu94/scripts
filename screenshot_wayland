#!/usr/bin/env bash

set -euo pipefail

# Output directory
OUTDIR="${HOME}/Pictures/Screenshots"
mkdir -p "${OUTDIR}"

STAMP="$(date +%Y-%m-%d_%H-%M-%S).png"
FILEPATH="${OUTDIR}/${STAMP}"

# Ensure required tools exist
need() {
    if ! command -v "$1" &>/dev/null; then
        notify-send "Missing Tool" "'$1' is not installed!"
        exit 1
    fi
}

case "${1:-}" in
    -area)
        need grim
        need slurp

        grim -g "$(slurp)" "${FILEPATH}"
        notify-send -i "${FILEPATH}" "Screenshot Taken" "Saved as ${STAMP} in ${OUTDIR}"
        ;; 

    -copy_area)
        need grim
        need slurp
        need wl-copy

        TMPFILE="$(mktemp --suffix=.png)"
        grim -g "$(slurp)" "${TMPFILE}"
        wl-copy --type image/png < "${TMPFILE}"
        notify-send -i "${TMPFILE}" "Screenshot Copied" "Selected area copied to clipboard"
        ;;

    -monitor)
        need grim
        need hyprctl
        need jq

        MON="$(hyprctl -j monitors | jq -r '.[] | select(.focused==true) | .name')"
        grim -o "${MON}" "${FILEPATH}"
        notify-send -i "${FILEPATH}" "Screenshot Taken" "Saved ${STAMP} in ${OUTDIR}"
        ;;

    -copy_monitor)
        need grim
        need hyprctl
        need jq
        need wl-copy

        MON="$(hyprctl -j monitors | jq -r '.[] | select(.focused==true) | .name')"
        TMPFILE="$(mktemp --suffix=.png)"
        grim -o "${MON}" "${TMPFILE}"
        wl-copy --type image/png < "${TMPFILE}"
        notify-send -i "${TMPFILE}" "Screenshot Copied" "${MON} copied to clipboard"
        ;;
    *)
        echo "Usage: $0 -area | -copy_area | -monitor | -copy_monitor"
        exit 1
        ;;
esac

